# Скопируйте в .env и поменяйте значения перед запуском на сервере.
ENVIRONMENT=dev
POSTGRES_USER=magazin
POSTGRES_PASSWORD=magazin
POSTGRES_DB=magazin

# Длинная случайная строка, например: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-in-production-0000

# console: SMS-код пишется в лог и показывается на странице входа (только при ENVIRONMENT=dev)
SMS_PROVIDER=console

# Телефоны, которые при первом входе становятся администраторами платформы
ADMIN_PHONES=["+998900000001"]

PLATFORM_COMMISSION_PERCENT=5
CNY_MARKUP_PERCENT=2

# Тестовая оплата без Payme и Click; на проде выключить
MOCK_PAYMENTS_ENABLED=true

CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
HTTP_PORT=8080
